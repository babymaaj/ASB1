// Windows file properties for ASB.vst3 (Explorer > Properties > Details) + icon.
#include <winver.h>
1 ICON "../../assets/asb.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,0,0
 PRODUCTVERSION 0,6,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "maai"
      VALUE "FileDescription", "ASB - ASIO Stream Bridge (VST3)"
      VALUE "FileVersion", "0.6.0"
      VALUE "InternalName", "ASB"
      VALUE "LegalCopyright", "maai"
      VALUE "OriginalFilename", "ASB.vst3"
      VALUE "ProductName", "ASB"
      VALUE "ProductVersion", "0.6.0-alpha"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
