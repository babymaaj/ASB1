name: windows-build
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: windows-latest   # Visual Studio 2026 since June 2026; CMake picks the installed VS automatically
    steps:
      - uses: actions/checkout@v4
      - name: Fetch VST3 SDK
        shell: bash
        run: git clone --depth 1 --recursive --shallow-submodules https://github.com/steinbergmedia/vst3sdk.git third_party/vst3sdk
      - name: Configure
        shell: bash
        run: |
          mkdir -p out
          set -o pipefail
          cmake -S . -B build -A x64 -DASB_RUN_VALIDATOR=OFF 2>&1 | tee out/configure-log.txt
      - name: Build
        shell: bash
        run: |
          set -o pipefail
          cmake --build build --config Release 2>&1 | tee out/build-log.txt
      - name: Steinberg validator
        shell: bash
        run: |
          set -o pipefail
          V=$(ls build/bin/Release/validator.exe 2>/dev/null || ls build/bin/validator.exe)
          "$V" -e build/VST3/Release/ASIOStreamBridge.vst3 2>&1 | tee out/validator-log.txt
      - name: Crash stack (validator under cdb)
        if: failure()
        shell: bash
        run: |
          CDB="/c/Program Files (x86)/Windows Kits/10/Debuggers/x64/cdb.exe"
          [ -f "$CDB" ] || { echo "cdb not installed"; exit 0; }
          V=$(ls build/bin/Release/validator.exe 2>/dev/null || ls build/bin/validator.exe)
          "$CDB" -g -G -lines -y "srv*C:\\symbols*https://msdl.microsoft.com/download/symbols;build/VST3/Release/ASIOStreamBridge.vst3/Contents/x86_64-win" \
            -c ".lines -e; .ecxr; kpn 40; r; q" "$V" -e build/VST3/Release/ASIOStreamBridge.vst3 > out/cdb-log.txt 2>&1 || true
          grep -v -E "^ModLoad|^\(.*\): Load module|Symbol search path|Executable search path" out/cdb-log.txt | tail -45 > out/cdbstack-log.txt || true
      - name: Device probe (runner has no real audio device; checks for crashes)
        shell: bash
        run: |
          P=$(ls build/bin/Release/asb_probe.exe 2>/dev/null || ls build/Release/asb_probe.exe)
          "$P" list 2>&1 | tee out/probe-log.txt
          "$P" 0 3 2>&1 | tee -a out/probe-log.txt
      - name: Tests (core + state)
        shell: bash
        run: |
          set -o pipefail
          ctest --test-dir build -C Release --output-on-failure 2>&1 | tee out/test-log.txt
      - name: Surface errors as annotations
        if: failure()
        shell: bash
        run: |
          # Compiler/linker/test errors as one annotation (readable via the API without downloading logs)
          cat out/*-log.txt 2>/dev/null | grep -E " error |error C|error LNK|fatal error|CMake Error|FAILED|Failed|Result:" \
            | sed 's/\r//' | sort -u | head -60 > err.txt || true
          [ -s err.txt ] || tail -40 out/*-log.txt > err.txt 2>/dev/null || true
          msg=$(sed 's/%/%25/g' err.txt | awk '{printf "%s%%0A", $0}')
          echo "::error title=Build/test errors::${msg}"
          for f in validator cdbstack probe; do
            [ -f out/$f-log.txt ] || continue
            m=$(tail -45 out/$f-log.txt | sed 's/\r//; s/%/%25/g' | awk '{printf "%s%%0A", $0}')
            echo "::error title=$f tail::${m}"
          done
      - name: Package
        if: always()
        shell: bash
        run: |
          mkdir -p out
          cp -r build/VST3/Release/ASIOStreamBridge.vst3 out/ 2>/dev/null || true
          cp build/bin/Release/asb_probe.exe out/ 2>/dev/null || cp build/Release/asb_probe.exe out/ 2>/dev/null || true
      - uses: actions/upload-artifact@v4
        if: always()
        with: { name: ASIOStreamBridge-win64, path: out }
