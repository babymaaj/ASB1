name: build
on:
  push:
    branches: ['**']
    tags: ['v*']          # pushing a tag like v0.5.0 builds AND publishes a GitHub Release
  workflow_dispatch:
permissions:
  contents: write         # screenshots branch + releases
jobs:
  build:
    name: windows
    runs-on: windows-latest
    outputs:
      version: ${{ steps.ver.outputs.version }}
      release: ${{ steps.ver.outputs.release }}
      tag: ${{ steps.ver.outputs.tag }}   # Visual Studio 2026 since June 2026; CMake picks the installed VS automatically
    steps:
      - uses: actions/checkout@v4
      - name: Fetch VST3 SDK
        shell: bash
        run: git clone --depth 1 --recursive --shallow-submodules https://github.com/steinbergmedia/vst3sdk.git third_party/vst3sdk
      - name: Version
        id: ver
        shell: bash
        run: |
          v=$(grep -oP 'project\(ASB VERSION \K[0-9.]+' CMakeLists.txt)
          echo "version=$v" >> "$GITHUB_OUTPUT"
          # release when: a v* tag is pushed, OR a commit on main says [release] in its message
          rel=false
          if [[ "$GITHUB_REF" == refs/tags/v* ]]; then rel=true; fi
          if [[ "$GITHUB_REF" == refs/heads/main ]] && git log -1 --format=%B | grep -q '\[release\]'; then rel=true; fi
          echo "release=$rel" >> "$GITHUB_OUTPUT"
          echo "tag=v$v" >> "$GITHUB_OUTPUT"
          if [[ "$GITHUB_REF" == refs/tags/v* && "${GITHUB_REF#refs/tags/v}" != "$v"* ]]; then
            echo "::error::tag ${GITHUB_REF#refs/tags/} does not match CMake version $v"; exit 1
          fi
      - name: Configure
        shell: bash
        run: |
          mkdir -p out
          set -o pipefail
          cmake -S . -B build -A x64 -DASB_RUN_VALIDATOR=OFF 2>&1 | tee out/configure-log.txt
      - name: Build
        shell: bash
        run: |
          set -o pipefail
          cmake --build build --config Release 2>&1 | tee out/build-log.txt
          find build -name validator.exe -o -name asb_probe.exe
      - name: Steinberg validator
        shell: bash
        run: |
          set -o pipefail
          V=$(find build -name validator.exe | head -1); echo "validator: $V"
          "$V" -e build/VST3/Release/ASB.vst3 2>&1 | tee out/validator-log.txt
      - name: Crash stack (validator under cdb)
        if: failure()
        shell: bash
        run: |
          CDB="/c/Program Files (x86)/Windows Kits/10/Debuggers/x64/cdb.exe"
          [ -f "$CDB" ] || { echo "cdb not installed"; exit 0; }
          V=$(find build -name validator.exe | head -1); echo "validator: $V"
          "$CDB" -g -G -lines -y "srv*C:\\symbols*https://msdl.microsoft.com/download/symbols;build/VST3/Release/ASB.vst3/Contents/x86_64-win" \
            -c ".lines -e; .ecxr; kpn 40; r; q" "$V" -e build/VST3/Release/ASB.vst3 > out/cdb-log.txt 2>&1 || true
          grep -v -E "^ModLoad|^\(.*\): Load module|Symbol search path|Executable search path" out/cdb-log.txt | tail -45 > out/cdbstack-log.txt || true
      - name: Device probe (runner has no real audio device; checks for crashes)
        shell: bash
        run: |
          P=$(find build -name asb_probe.exe | head -1); echo "probe: $P"
          "$P" list 2>&1 | tee out/probe-log.txt
          "$P" 0 3 2>&1 | tee -a out/probe-log.txt
      - name: UI screenshots (real Windows) -> ci-screenshots branch
        if: github.ref == 'refs/heads/main'
        continue-on-error: true
        shell: bash
        run: |
          E=$(find build -name editor_preview.exe | head -1)
          "$E" ui.bmp 3000 --stream || true
          "$E" ui-off.bmp 2500 || true
          ASB_PREVIEW_PAGE=settings "$E" ui-settings.bmp 2500 || true
          ls -la ui*.bmp || exit 0
          mkdir shots && mv ui*.bmp shots/
          cd shots
          git init -q && git checkout -q -b ci-screenshots
          git config user.name "ci" && git config user.email "ci@users.noreply.github.com"
          git add -A && git commit -qm "UI screenshots for ${GITHUB_SHA}"
          git push -q -f "https://x-access-token:${{ github.token }}@github.com/${GITHUB_REPOSITORY}.git" ci-screenshots
      - name: Tests (core + state)
        shell: bash
        run: |
          set -o pipefail
          ctest --test-dir build -C Release --output-on-failure 2>&1 | tee out/test-log.txt
      - name: Surface errors as annotations
        if: failure()
        shell: bash
        run: |
          cat out/*-log.txt 2>/dev/null | grep -E " error |error C|error LNK|fatal error|CMake Error|FAILED|Failed|Result:" \
            | sed 's/\r//' | sort -u | head -60 > err.txt || true
          [ -s err.txt ] || tail -40 out/*-log.txt > err.txt 2>/dev/null || true
          msg=$(sed 's/%/%25/g' err.txt | awk '{printf "%s%%0A", $0}')
          echo "::error title=Build/test errors::${msg}"
          for f in validator cdbstack probe; do
            [ -f out/$f-log.txt ] || continue
            m=$(tail -45 out/$f-log.txt | sed 's/\r//; s/%/%25/g' | awk '{printf "%s%%0A", $0}')
            echo "::error title=$f tail::${m}"
          done
      - name: Package
        if: always()
        shell: bash
        run: |
          mkdir -p out
          cp -r build/VST3/Release/ASB.vst3 out/ 2>/dev/null || true
          for exe in asb_probe core_tests editor_preview; do
            f=$(find build -name "$exe.exe" -path "*Release*" | head -1)
            [ -n "$f" ] && cp "$f" out/ || echo "::warning::$exe.exe not found"
          done
          cat > out/README-FIRST.txt <<'TXT'
          ASB.vst3               = the plugin (a folder). Copy the whole folder to C:\Program Files\Common Files\VST3\
                                   (delete an old ASIOStreamBridge.vst3 there if you have one). Or just run ASB-Setup.
          asb_probe.exe          = test tool:  asb_probe.exe list   /   asb_probe.exe 2 8
          core_tests.exe         = self-test; should end with ALL PASSED.
          editor_preview.exe     = opens the plugin window without FL (try: editor_preview.exe --stream)
          *-log.txt              = build logs (send these if something fails).
          TXT
          echo "::notice title=Packaged files::$(cd out && find . -type f | sort | tr '\n' ' ')"
      # ---- code signing: runs only when the repo has the secrets SIGN_PFX_BASE64 + SIGN_PFX_PASSWORD
      - name: Sign plugin
        id: sign
        if: success()
        shell: pwsh
        env:
          PFX_B64: ${{ secrets.SIGN_PFX_BASE64 }}
          PFX_PASS: ${{ secrets.SIGN_PFX_PASSWORD }}
        run: |
          if (-not $env:PFX_B64) { echo "signed=false" >> $env:GITHUB_OUTPUT; Write-Host "No signing certificate configured - skipping."; exit 0 }
          [IO.File]::WriteAllBytes("$env:RUNNER_TEMP\sign.pfx", [Convert]::FromBase64String($env:PFX_B64))
          $st = Get-ChildItem "C:\Program Files (x86)\Windows Kits\10\bin\*\x64\signtool.exe" | Sort-Object FullName -Descending | Select-Object -First 1
          & $st.FullName sign /f "$env:RUNNER_TEMP\sign.pfx" /p $env:PFX_PASS /fd sha256 /tr http://timestamp.digicert.com /td sha256 "out\ASB.vst3\Contents\x86_64-win\ASB.vst3"
          if ($LASTEXITCODE) { exit 1 }
          echo "signed=true" >> $env:GITHUB_OUTPUT
          echo "signtool=$($st.FullName)" >> $env:GITHUB_OUTPUT
      - name: Build installer (ASB-Setup.exe)
        if: success()
        shell: pwsh
        run: |
          if (-not (Test-Path "C:\Program Files (x86)\Inno Setup 6\ISCC.exe")) { choco install innosetup -y --no-progress | Out-Null }
          & "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" /Q "/DAppVersion=${{ steps.ver.outputs.version }}" "/DSrcDir=..\out" installer\asb.iss
          if ($LASTEXITCODE) { exit 1 }
          Get-ChildItem dist
      - name: Sign installer
        if: success() && steps.sign.outputs.signed == 'true'
        shell: pwsh
        env:
          PFX_PASS: ${{ secrets.SIGN_PFX_PASSWORD }}
        run: |
          & "${{ steps.sign.outputs.signtool }}" sign /f "$env:RUNNER_TEMP\sign.pfx" /p $env:PFX_PASS /fd sha256 /tr http://timestamp.digicert.com /td sha256 (Get-ChildItem dist\ASB-Setup-*.exe).FullName
          if ($LASTEXITCODE) { exit 1 }
      - uses: actions/upload-artifact@v4
        if: always()
        with: { name: ASB-win64, path: out }
      - uses: actions/upload-artifact@v4
        if: success()
        with: { name: ASB-Setup, path: dist }

  mac:
    runs-on: macos-15-intel   # Apple Silicon pool is often capacity-limited; still builds a universal binary
    steps:
      - uses: actions/checkout@v4
      - name: Fetch VST3 SDK + Apple AudioUnitSDK
        run: |
          git clone --depth 1 --recursive --shallow-submodules https://github.com/steinbergmedia/vst3sdk.git third_party/vst3sdk
          git clone --depth 1 -b AudioUnitSDK-1.1.0 https://github.com/apple/AudioUnitSDK.git third_party/AudioUnitSDK   # 1.4+ needs C++23; the VST3 AU wrapper is C++17
      - name: Version
        id: ver
        run: echo "version=$(grep -oE 'project\(ASB VERSION [0-9.]+' CMakeLists.txt | grep -oE '[0-9.]+$')" >> "$GITHUB_OUTPUT"
      - name: Configure (Xcode, universal arm64 + x86_64; Xcode is required for the AU)
        run: |
          mkdir -p out
          set -o pipefail
          cmake -S . -B build -G Xcode -DCMAKE_OSX_ARCHITECTURES="arm64;x86_64" -DASB_RUN_VALIDATOR=OFF -DSMTG_DISABLE_CODE_SIGNING=ON 2>&1 | tee out/configure-log.txt
          grep -q "SMTG_AUDIOUNIT_SDK_PATH is set" out/configure-log.txt || { echo "::error::AudioUnitSDK not detected"; exit 1; }
      - name: Build
        run: |
          set -o pipefail
          cmake --build build --config Release -- -quiet -jobs 4 2>&1 | tee out/build-log.txt
          find build -maxdepth 4 \( -name "ASB.vst3" -o -name "ASB.component" \)
          lipo -info build/VST3/Release/ASB.vst3/Contents/MacOS/ASB
          lipo -info build/VST3/Release/ASB.component/Contents/MacOS/ASB
      - name: Steinberg validator
        run: |
          set -o pipefail
          V=$(find build -name validator -type f -perm +111 | head -1); echo "validator: $V"
          "$V" -e build/VST3/Release/ASB.vst3 2>&1 | tee out/validator-log.txt
      - name: Apple AU validation (auval, strict)
        run: |
          set -o pipefail
          ls ~/Library/Audio/Plug-Ins/Components/
          killall -9 AudioComponentRegistrar 2>/dev/null || true
          auval -a 2>&1 | grep -i maai || true
          auval -strict -v aufx Asb1 Maai 2>&1 | tee out/auval-log.txt
          grep -q "AU VALIDATION SUCCEEDED" out/auval-log.txt
      - name: Device probe
        run: |
          P=$(find build -name asb_probe -type f -perm +111 | head -1)
          "$P" list 2>&1 | tee out/probe-log.txt
          "$P" 0 3 2>&1 | tee -a out/probe-log.txt || true
      - name: Tests (core + state + editor core)
        run: |
          set -o pipefail
          ctest --test-dir build -C Release --output-on-failure 2>&1 | tee out/test-log.txt
      - name: UI screenshots (real macOS) -> ci-screenshots-mac branch
        if: github.ref == 'refs/heads/main'
        continue-on-error: true
        run: |
          E=$(find build -name editor_preview_mac -type f -perm +111 | head -1)
          "$E" ui.png 3000 --stream || true
          "$E" ui-off.png 2500 || true
          ASB_PREVIEW_PAGE=settings "$E" ui-settings.png 2500 || true
          ls -la ui*.png || exit 0
          mkdir shots && mv ui*.png shots/
          cd shots
          git init -q && git checkout -q -b ci-screenshots-mac
          git config user.name "ci" && git config user.email "ci@users.noreply.github.com"
          git add -A && git commit -qm "macOS UI screenshots for ${GITHUB_SHA}"
          git push -q -f "https://x-access-token:${{ github.token }}@github.com/${GITHUB_REPOSITORY}.git" ci-screenshots-mac
      - name: Surface errors as annotations
        if: failure()
        run: |
          cat out/*-log.txt 2>/dev/null | grep -E "error:|Error |FAILED|Failed|Result:|ld: " | sort -u | head -60 > err.txt || true
          [ -s err.txt ] || tail -40 out/*-log.txt > err.txt 2>/dev/null || true
          msg=$(sed 's/%/%25/g' err.txt | awk '{printf "%s%%0A", $0}')
          echo "::error title=macOS build/test errors::${msg}"
          for f in validator auval probe; do
            [ -f out/$f-log.txt ] || continue
            m=$(tail -45 out/$f-log.txt | sed 's/%/%25/g' | awk '{printf "%s%%0A", $0}')
            echo "::error title=mac $f tail::${m}"
          done
      - name: Package (.pkg installer with VST3 + AU, ad-hoc signed)
        if: success()
        run: |
          v="${{ steps.ver.outputs.version }}"
          P=pkgroot/Library/Audio/Plug-Ins
          mkdir -p dist $P/VST3 $P/Components
          cp -R build/VST3/Release/ASB.vst3 $P/VST3/
          # the build links plugin.vst3 inside the component; ship a real copy (-L follows the link)
          cp -RL build/VST3/Release/ASB.component $P/Components/
          test -d $P/Components/ASB.component/Contents/Resources/plugin.vst3 && ! test -L $P/Components/ASB.component/Contents/Resources/plugin.vst3
          # Ad-hoc signatures (required on Apple Silicon). Developer ID + notarization replace these later (SIGNING.md).
          codesign --force --deep --sign - $P/VST3/ASB.vst3
          codesign --force --deep --sign - $P/Components/ASB.component
          codesign --verify --deep --strict $P/VST3/ASB.vst3
          codesign --verify --deep --strict $P/Components/ASB.component
          pkgbuild --root pkgroot --identifier lol.maai.asb --version "$v" --install-location / dist/asb-plugins.pkg
          productbuild --package dist/asb-plugins.pkg --identifier lol.maai.asb.installer --version "$v" "dist/ASB-$v-mac.pkg"
          rm dist/asb-plugins.pkg
          (cd $P/VST3 && zip -qry "$GITHUB_WORKSPACE/dist/ASB-$v-mac-vst3.zip" ASB.vst3)
          (cd $P/Components && zip -qry "$GITHUB_WORKSPACE/dist/ASB-$v-mac-au.zip" ASB.component)
          cp -R build/VST3/Release/ASB.vst3 out/ 2>/dev/null || true
          ls -la dist
      - uses: actions/upload-artifact@v4
        if: always()
        with: { name: ASB-mac, path: out }
      - uses: actions/upload-artifact@v4
        if: success()
        with: { name: ASB-mac-installer, path: dist }

  release:
    needs: [build, mac]
    if: needs.build.outputs.release == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with: { name: ASB-Setup, path: dist }
      - uses: actions/download-artifact@v4
        with: { name: ASB-mac-installer, path: dist }
      - uses: actions/download-artifact@v4
        with: { name: ASB-win64, path: win }
      - name: Publish GitHub Release (Windows + macOS)
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          v="${{ needs.build.outputs.version }}"; tag="${{ needs.build.outputs.tag }}"
          awk -v v="$v" '$0 ~ "^## "v {f=1; next} /^## / && f {exit} f' CHANGELOG.md > notes.md
          cat >> notes.md <<EOF2

          ---
          **Windows:** run \`ASB-Setup-$v.exe\`, then in FL Studio: Options > Manage plugins > Find plugins.
          **macOS:** open \`ASB-$v-mac.pkg\` (installs VST3 + Audio Unit; if macOS blocks it: right-click > Open, or System Settings > Privacy & Security > Open Anyway), then rescan plugins in your DAW. In Logic/GarageBand ASB appears under Audio Units > maai > ASB. For Discord/OBS on Mac install the free [BlackHole 2ch](https://existential.audio/blackhole/) and pick it as ASB's OUTPUT.
          EOF2
          (cd win && zip -qr "../dist/ASB-$v-win-vst3.zip" ASB.vst3)
          ls -la dist
          if gh release view "$tag" >/dev/null 2>&1; then echo "::warning::release $tag already exists - bump the version in CMakeLists.txt"; exit 0; fi
          gh release create "$tag" dist/ASB-Setup-*.exe dist/ASB-*-mac.pkg dist/ASB-*-win-vst3.zip dist/ASB-*-mac-vst3.zip dist/ASB-*-mac-au.zip \
            --target "$GITHUB_SHA" --title "ASB $tag" --notes-file notes.md
